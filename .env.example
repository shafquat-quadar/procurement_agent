# ---------------------------------------------------------------------------
# MaaS (Model-as-a-Service) LLM configuration
# ---------------------------------------------------------------------------
# Credentials and endpoints are environment-only. Never commit real values.
# ACCESS_KEY / ACCESS_SECRET  = client key + secret key from the application portal
# TOKEN_URL                   = APIM token endpoint, e.g. https://<apim-host>/token
# LLM_URL                     = MaaS LLM inference endpoint
# SUBSCRIPTION_KEY            = APIM subscription key (sent as Ocp-Apim-Subscription-Key)
ACCESS_KEY=
ACCESS_SECRET=
TOKEN_URL=
LLM_URL=
LLM_MODEL=gemini-3
SUBSCRIPTION_KEY=

# Absolute path to a CA/SSL certificate bundle used for outbound TLS.
# Leave empty to use system defaults.
SSL_CERTIFICATE=

# ---------------------------------------------------------------------------
# MCP server (existing local SAP OData MCP server over SSE)
# ---------------------------------------------------------------------------
MCP_SERVER_URL=http://127.0.0.1:8000/sse

# ---------------------------------------------------------------------------
# Networking / local service
# ---------------------------------------------------------------------------
NO_PROXY=127.0.0.1,localhost

# FastAPI base URL the Chainlit UI calls.
CHAT_API_URL=http://127.0.0.1:9000

# Local SQLite trace database path.
TRACE_DB_PATH=./procurement_traces.db

# Log level (debug, info, warning, error)
LOG_LEVEL=info
